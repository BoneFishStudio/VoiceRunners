{
  "rules": {
    "rooms": {
      ".read": true,
      "$room_id": {
        ".read": true,
        ".write": "!data.exists() || (data.child('status').val() === 'waiting') || (newData.val() === null && (!data.hasChild('players') || !data.child('players').hasChildren()))",
        "players": {
          "$player_id": {
            ".write": "true",
            ".validate": "newData.hasChildren(['id', 'name', 'score', 'distance', 'lives', 'alive', 'ready', 'joinedAt'])",
            "id": { ".validate": "newData.isString()" },
            "name": { ".validate": "newData.isString() && newData.val().length <= 20" },
            "score": { ".validate": "newData.isNumber()" },
            "distance": { ".validate": "newData.isNumber()" },
            "lives": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3" },
            "alive": { ".validate": "newData.isBoolean()" },
            "ready": { ".validate": "newData.isBoolean()" },
            "joinedAt": { ".validate": "newData.isNumber()" }
          }
        },
        "playerOrder": { ".write": "true", ".validate": "newData.isObject()" },
        "host": { ".validate": "newData.isString()" },
        "status": { ".validate": "newData.isString() && (newData.val() === 'waiting' || newData.val() === 'playing')" },
        "seed": { ".validate": "newData.isNumber()" },
        "maxPlayers": { ".validate": "newData.isNumber() && newData.val() >= 2 && newData.val() <= 4" },
        "password": {
          ".write": "!data.exists()",
          ".validate": "newData.isString() && newData.val().length <= 64"
        },
        "createdAt": { ".validate": "newData.isNumber()" },
        "startTime": { ".validate": "newData.isNumber()" },
        "gameState": {
          ".write": "true",
          "started": { ".validate": "newData.isBoolean()" },
          "seed": { ".validate": "newData.isNumber()" },
          "timestamp": { ".validate": "newData.isNumber()" },
          "finished": { ".validate": "newData.isBoolean()" },
          "finishTime": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        }
      }
    },

    "userRoles": {
      ".read": "auth != null",
      "$uid": {
        ".write": "root.child('userRoles').child(auth.uid).val() === 'admin' || (auth.uid === $uid && newData.val() === 'user' && (!data.exists() || data.val() === 'user'))",
        ".validate": "newData.isString() && (newData.val() === 'admin' || newData.val() === 'moderator' || newData.val() === 'user' || newData.val() === 'anon')"
      }
    },

    "gameConfig": {
      ".read": true,
      ".write": "root.child('userRoles').child(auth.uid).val() === 'admin' || root.child('userRoles').child(auth.uid).val() === 'moderator'",
      "baseSpeed": { ".validate": "newData.isNumber() && newData.val() >= 2 && newData.val() <= 20" },
      "maxSpeed": { ".validate": "newData.isNumber() && newData.val() >= 6 && newData.val() <= 30" },
      "rampSpeedBoost": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3" },
      "rampInterval": { ".validate": "newData.isNumber() && newData.val() >= 300 && newData.val() <= 3000" },
      "obstacleMinGap": { ".validate": "newData.isNumber() && newData.val() >= 60 && newData.val() <= 400" },
      "obstacleMaxGap": { ".validate": "newData.isNumber() && newData.val() >= 100 && newData.val() <= 600" },
      "pitChance": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 0.5" },
      "pitVolumeThreshold": { ".validate": "newData.isNumber() && newData.val() >= 0.05 && newData.val() <= 0.5" },
      "themeLength": { ".validate": "newData.isNumber() && newData.val() >= 300 && newData.val() <= 2000" },
      "themeBlendZone": { ".validate": "newData.isNumber() && newData.val() >= 50 && newData.val() <= 500" },
      "$other": { ".validate": false }
    },

    "leaderboard": {
      ".read": true,
      "$uid": {
        ".write": "auth != null && (root.child('userRoles').child(auth.uid).val() === 'admin' || root.child('userRoles').child(auth.uid).val() === 'moderator' || (auth.uid === $uid && (!data.exists() || !data.hasChild('lastSubmitTimestamp') || (newData.hasChild('lastSubmitTimestamp') && newData.child('lastSubmitTimestamp').val() > data.child('lastSubmitTimestamp').val() + 5000))))",
        "name": { ".validate": "newData.isString() && newData.val().length <= 20" },
        "score": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= (newData.parent().child('distance').val() * 3 + 8000)" },
        "distance": { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "timestamp": { ".validate": "newData.isNumber()" },
        "lastSubmitTimestamp": { ".validate": "newData.isNumber()" },
        "isGuest": { ".validate": "newData.isBoolean()" },
        "$other": { ".validate": false }
      }
    },

    "users": {
      ".read": "auth != null",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('userRoles').child(auth.uid).val() === 'admin' || root.child('userRoles').child(auth.uid).val() === 'moderator')",
        ".write": "auth != null && (auth.uid === $uid || root.child('userRoles').child(auth.uid).val() === 'admin')",
        "profile": {
          ".validate": "newData.isObject()",
          "displayName": { ".validate": "newData.isString() && newData.val().length <= 20" },
          "photoURL": { ".validate": "newData.isString() && newData.val().length <= 500" },
          "email": { ".validate": "newData.isString() && newData.val().length <= 100" },
          "createdAt": { ".validate": "newData.isNumber()" },
          "lastLogin": { ".validate": "newData.isNumber()" },
          "country": { ".validate": "newData.isString() && newData.val().length <= 3" },
          "level": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 9999" },
          "exp": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "coins": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "$other": { ".validate": false }
        },
        "statistics": {
          ".validate": "newData.isObject()",
          "highScore": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "bestDistance": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "gamesPlayed": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "wins": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "losses": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "$other": { ".validate": false }
        },
        "score": {
          ".validate": "newData.isObject()",
          "bestScore": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "bestDistance": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "timestamp": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        },
        "achievements": { ".validate": "newData.isObject()" },
        "settings": { ".validate": "newData.isObject()" },
        "$other": { ".validate": false }
      }
    }
  }
}
